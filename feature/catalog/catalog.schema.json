{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrec.dev/schema/feature-catalog-v1.json",
  "title": "OpenRec canonical feature catalog",
  "type": "object",
  "required": ["schema_version", "catalog_version", "policies", "features"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "catalog_version": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "minLength": 1},
    "taxonomy": {"type": "object"},
    "scene_presets": {"type": "object"},
    "policies": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/policy"}
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/feature"}
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "required": ["as_of", "time", "identity", "invalid_input"],
      "additionalProperties": true,
      "properties": {
        "as_of": {"type": "string", "minLength": 1},
        "time": {"type": "object"},
        "identity": {"type": "object"},
        "invalid_input": {"type": "object"}
      }
    },
    "feature": {
      "type": "object",
      "required": ["id", "definition_version", "entity", "group", "name", "description",
                   "value_type", "shape", "source", "default", "materialization", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(user|item|session|context|statistical|temporal|interaction)\\.[a-z][a-z0-9_]*$"},
        "definition_version": {"type": "integer", "minimum": 1},
        "entity": {"enum": ["user", "item", "session", "context", "interaction"]},
        "group": {"enum": ["profile", "behavior", "content", "request", "request_candidate", "affinity", "experiment"]},
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "description": {"type": "string", "minLength": 1},
        "value_type": {"enum": ["boolean", "int64", "float64", "string"]},
        "shape": {"enum": ["scalar", "categorical", "multi_value", "hashed_text"]},
        "hash_dim": {"type": "integer", "minimum": 1},
        "hash": {"type": "string", "minLength": 1},
        "tokenizer": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "scenes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source": {"type": "object", "required": ["logical_entity"], "additionalProperties": true},
        "aggregation": {"type": "object", "required": ["operator"], "additionalProperties": true},
        "policy": {"type": "string", "minLength": 1},
        "default": {},
        "materialization": {
          "type": "object",
          "required": ["online", "offline", "backfillable"],
          "additionalProperties": false,
          "properties": {
            "online": {"type": "boolean"},
            "offline": {"type": "boolean"},
            "backfillable": {"type": "boolean"}
          }
        },
        "status": {"enum": ["experimental", "stable", "deprecated"]}
      }
    }
  }
}
